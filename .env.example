# Written answers need at least one model. Without any, the app runs in
# retrieval-only mode and quotes the best-matching passages. With both
# configured, the composer lets you pick the model per question.

# Opus 5.5 (Anthropic API)
ANTHROPIC_API_KEY=
# LEMMA_MODEL=claude-opus-5-5
# LEMMA_EFFORT=high

# LFM3 1.7B (Liquid AI, open weights) through any OpenAI-compatible server.
#
# Local with llama.cpp b11960 or newer:
#   llama-server -hf LiquidAI/LFM3-1.7B-GGUF:Q4_K_M --jinja --port 8080
# LFM3_BASE_URL=http://127.0.0.1:8080/v1
#
# Local with Ollama 0.40.12 or newer (macOS):
#   ollama run lfm3
# LFM3_BASE_URL=http://127.0.0.1:11434/v1
# LFM3_MODEL=lfm3
#
# Hosted on OpenRouter (default model liquid/lfm-3-1.7b):
# OPENROUTER_API_KEY=
#
# Requests use the model card's math sampling (temperature 1.0, top_p 0.95,
# top_k 20). Override the temperature only if you have a reason to:
# LFM3_TEMPERATURE=

# Manim animations. Rendering is on when this Python can `import manim`
# (pip install manim). Set LEMMA_MANIM=off to turn it off.
# MANIM_PYTHON=python3
# MANIM_QUALITY=l            # l (480p, default), m (720p) or h (1080p)
# LEMMA_MANIM_TIMEOUT_MS=120000
# LEMMA_ANIM_DIR=            # where rendered videos are kept (default: system temp)
# LEMMA_MANIM=off

# Narration for animations: a MioTTS-Inference server running MioTTS-0.6B
# (see the README). Without it, videos get captions but no voice.
# MIOTTS_URL=http://127.0.0.1:8001
# MIOTTS_PRESET=en_female
# MIOTTS_REFERENCE=/path/to/voice.wav   # clone this clip instead of a preset

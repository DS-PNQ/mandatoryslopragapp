# Written answers need at least one model. Without any, the app runs in
# retrieval-only mode and quotes the best-matching passages. With both
# configured, the composer lets you pick the model per question.

# Opus 5.5 (Anthropic API)
ANTHROPIC_API_KEY=
# LEMMA_MODEL=claude-opus-5-5
# LEMMA_EFFORT=high

# LFM3 1.7B (Liquid AI, open weights) through any OpenAI-compatible server.
#
# Local with llama.cpp b11960 or newer:
#   llama-server -hf LiquidAI/LFM3-1.7B-GGUF:Q4_K_M --jinja --port 8080
# LFM3_BASE_URL=http://127.0.0.1:8080/v1
#
# Local with Ollama 0.40.12 or newer (macOS):
#   ollama run lfm3
# LFM3_BASE_URL=http://127.0.0.1:11434/v1
# LFM3_MODEL=lfm3
#
# Hosted on OpenRouter (default model liquid/lfm-3-1.7b):
# OPENROUTER_API_KEY=
#
# Requests use the model card's math sampling (temperature 1.0, top_p 0.95,
# top_k 20). Override the temperature only if you have a reason to:
# LFM3_TEMPERATURE=
# Output caps (tokens). LFM3's includes its reasoning; keep the server's per-slot context above it plus the prompt.
# LFM3_MAX_TOKENS=28000
# LEMMA_MAX_TOKENS=64000

# Ternary Bonsai 2.5 27B (prism-ml/Ternary-Bonsai-2.5-27B-GGUF).
# Fastest: PrismML's llama.cpp build with the MTP file and speculative decoding (see the README):
#   llama-server -m Ternary-Bonsai-2.5-27B-PTQ1_0-mtp.gguf --jinja -ngl 99 -fa on -c 40960 -np 1 --min-p 0 --port 8095 \
#     --spec-type draft-mtp --spec-draft-n-min 0 --spec-draft-n-max 3 --spec-draft-p-min 0.1
# Stock llama.cpp b11556 or newer, no MTP:
#   llama-server -hf prism-ml/Ternary-Bonsai-2.5-27B-GGUF:Q2_0 --jinja -ngl 99 -fa on -c 40960 -np 1 --min-p 0 --port 8095
# BONSAI_BASE_URL=http://127.0.0.1:8095/v1
# BONSAI_MODEL=ternary-bonsai-2.5-27b
# Set to 1 when the server was started with --mmproj, so Bonsai can read uploaded images:
# BONSAI_VISION=
# BONSAI_MAX_TOKENS=28000

# Scanned PDFs are transcribed at upload by a vision model: Bonsai (above, with
# BONSAI_VISION=1) by default, or any OpenAI-compatible vision endpoint here.
# LEMMA_OCR_BASE_URL=http://127.0.0.1:8000/v1
# LEMMA_OCR_MODEL=allenai/olmOCR-2-7B
# LEMMA_OCR_API_KEY=
# LEMMA_OCR_MAX_PAGES=60

# Neural retrieval (optional). Without these, retrieval is LSA + e-means + BM25.
# Embeddings, fused with the lexical and LSA rankings. EmbeddingGemma 2 (needs a
# llama.cpp recent enough to know the gemma-embedding2 architecture):
#   llama-server -hf ggml-org/embeddinggemma-2-GGUF:Q8_0 --embedding --pooling mean -c 8192 -b 8192 -ub 8192 --port 8097
# LEMMA_EMBED_URL=http://127.0.0.1:8097/v1
# LEMMA_EMBED_MODEL=embeddinggemma-2
# or Qwen3-Embedding-0.6B:
#   llama-server -hf Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0 --embedding --pooling last -c 8192 -b 8192 -ub 8192 --port 8097
# LEMMA_EMBED_MODEL=qwen3-embedding-0.6b
# Prompt format: inferred from the model name; set it for other names (qwen3, gemma or plain):
# LEMMA_EMBED_PROMPTS=
# EmbeddingGemma 2 query task (default "question answering"; "search result" is the other retrieval prompt):
# LEMMA_EMBED_GEMMA_TASK=
# Matryoshka truncation, e.g. 256 (both models are trained for it); empty = full vectors:
# LEMMA_EMBED_DIM=
# Cross-encoder reranker over the 20 fused candidates:
#   llama-server -hf ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF --reranking -c 8192 -b 4096 -ub 4096 --port 8098
# LEMMA_RERANK_URL=http://127.0.0.1:8098/v1
# LEMMA_RERANK_MODEL=qwen3-reranker-0.6b
# LEMMA_RETRIEVAL_API_KEY=   # bearer token, if the endpoints need one

# Manim animations. Rendering is on when this Python can `import manim`
# (pip install manim). Set LEMMA_MANIM=off to turn it off.
# MANIM_PYTHON=python3
# MANIM_QUALITY=l            # l (480p, default), m (720p) or h (1080p)
# LEMMA_MANIM_TIMEOUT_MS=120000
# LEMMA_MANIM_REPAIRS=2      # times a failed scene goes back to the model before the storyboard fallback
# LEMMA_ANIM_DIR=            # where rendered videos are kept (default: system temp)
# LEMMA_MANIM=off

# Narration for animations: a MioTTS-Inference server running MioTTS-0.6B
# (see the README). Without it, videos get captions but no voice.
# MIOTTS_CONCURRENCY=3      # lines voiced at once
# MIOTTS_URL=http://127.0.0.1:8001
# MIOTTS_PRESET=en_female
# MIOTTS_REFERENCE=/path/to/voice.wav   # clone this clip instead of a preset

# The Rust text core (lib/native/lemmaslop_core.wasm) tokenizes and ranks uploads.
# Set to off to use the TypeScript implementation instead (same results, slower).
# LEMMA_NATIVE=off
